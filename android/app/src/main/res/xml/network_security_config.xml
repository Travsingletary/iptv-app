<?xml version="1.0" encoding="utf-8"?>
<!-- Allow HTTP IPTV portals (MegaOTT / Xtream often use http://host:port). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
