# Copy to `.env` / `.env.local` for local overrides.
# Never commit real secrets.

# --- Optional Supabase telemetry + reminders ---
# When unset, events buffer in localStorage (`aether_event_buffer`) and stay local.
# Reminders always persist in localStorage; Supabase sync is best-effort when set.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional AI provider (Phase 4+ OpenAI-compatible multi-round tools loop) ---
# Without OPENAI_API_KEY, assistant uses deterministic mock agent loop (still executable in UI).
# When OPENAI_API_KEY is set, server runs a real tools loop (model → tools → local allowlist → model).
# Server-side (Vite middleware / companion):
AI_PROVIDER=
OPENAI_API_KEY=
# Optional gateway overrides:
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Client-side local fallback hint (optional — prefer server keys):
VITE_AI_PROVIDER=
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=
VITE_OPENAI_MODEL=

# Companion server port (`npm run start:api`)
PORT=4173

# E2E base URL override
# AETHER_URL=http://127.0.0.1:5173
