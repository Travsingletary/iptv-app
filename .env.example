# Copy to `.env` / `.env.local` for local overrides.
# Never commit real secrets.

# --- Optional Supabase telemetry ---
# When unset, events buffer in localStorage (`aether_event_buffer`) and stay local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Optional AI provider (Phase 2) ---
# Without these, assistant uses deterministic mock tools (still executable in UI).
# Server-side (Vite middleware / companion):
AI_PROVIDER=
OPENAI_API_KEY=

# Client-side local fallback hint (optional):
VITE_AI_PROVIDER=
VITE_OPENAI_API_KEY=

# Companion server port (`npm run start:api`)
PORT=4173
